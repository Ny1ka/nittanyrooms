# Server-side only (Vercel project env vars). Never prefix with VITE_.

# Kill switch for live library availability. "off" → /api/availability returns 503
# and the app shows "Check on PSU site".
LIBCAL_LIVE=on

# Identifier sent to psu.libcal.com. Leave unset to use the temporary browser UA
# (testing only). Before public launch set something honest, e.g.:
# LIBCAL_USER_AGENT=NittanyRooms/0.1 (+https://github.com/Ny1ka/nittanyrooms)
LIBCAL_USER_AGENT=
