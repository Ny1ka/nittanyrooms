# Server-side only (Vercel project env vars). Never prefix with VITE_.

# Kill switch for live library availability. "off" → /api/availability returns 503
# and the app shows "Check on PSU site".
LIBCAL_LIVE=on

# Identifier sent to psu.libcal.com. Leave unset to use the temporary browser UA
# (testing only). Before public launch set something honest, e.g.:
# LIBCAL_USER_AGENT=NittanyRooms/0.1 (+https://github.com/Ny1ka/nittanyrooms)
LIBCAL_USER_AGENT=

# --- Server push alerts ("Notify me when it opens" with the site closed) ---
# Redis: add Upstash Redis from the Vercel Marketplace (Storage tab). It sets these:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Web Push keys: generate with `node apps/web/scripts/gen-push-keys.mjs`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Shared secret for the scheduler (same value as the GitHub Actions secret CRON_SECRET)
CRON_SECRET=
# Optional: public site URL used in notification links
SITE_URL=https://nittanyrooms.vercel.app
