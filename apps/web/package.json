{
  "name": "@nittany-rooms/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm --filter @nittany-rooms/core validate:data && tsc --noEmit && vite build",
