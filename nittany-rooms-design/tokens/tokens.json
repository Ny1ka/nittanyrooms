{
  "version": "2.0.0",
  "name": "Nittany Rooms: minimal, dark-first",
  "defaultTheme": "dark",
  "implementation": "apps/web/src/index.css (CSS variables --nr-*, exposed to Tailwind as semantic colors)",
  "theme": {
    "dark": {
      "bg": {
        "value": "#0A1628",
        "use": "App and map surround"
      },
      "surface": {
        "value": "#0F1F38",
        "use": "Sidebar, sheets, popovers"
      },
      "surface2": {
        "value": "#16294A",
        "use": "Inputs, pills, row hover, timeline track"
      },
      "surface3": {
        "value": "#1F3358",
        "use": "Pressed/secondary, short gaps"
      },
      "line": {
        "value": "#22365A",
        "use": "Borders and dividers (1px)"
      },
      "fg": {
        "value": "#E8EEF7",
        "use": "Primary text"
      },
      "muted": {
        "value": "#8FA0BA",
        "use": "Secondary text"
      },
      "subtle": {
        "value": "#7E92B3",
        "use": "Tertiary text, section labels (≥4.5:1 on bg, surface, surface2)"
      },
      "accent": {
        "value": "#FFC845",
        "use": "Open rooms, primary CTA, selected floor; always with accentInk text"
      },
      "accentInk": {
        "value": "#12284C",
        "use": "Text on accent"
      },
      "accentText": {
        "value": "#FFC845",
        "use": "Accent-colored text (opens soon, open counts)"
      },
      "accentBorder": {
        "value": "#FFC845",
        "use": "Dashed 'opens soon' outline, focus ring"
      },
      "accentSoft": {
        "value": "rgba(255,200,69,0.10)",
        "use": "Selected row background"
      },
      "occupied": {
        "value": "#2B4170",
        "use": "Occupied fill"
      },
      "occupiedFg": {
        "value": "#DCE4F2",
        "use": "Text on occupied"
      },
      "hatch": {
        "value": [
          "#1F3358",
          "#2B4170"
        ],
        "use": "Unavailable/closed stripes"
      },
      "dots": {
        "value": [
          "#3A5280",
          "#16294A"
        ],
        "use": "Unknown availability dots"
      },
      "now": {
        "value": "#FF5C93",
        "use": "Current-time marker only"
      }
    },
    "light": {
      "bg": {
        "value": "#F5F7FA"
      },
      "surface": {
        "value": "#FFFFFF"
      },
      "surface2": {
        "value": "#F0F3F7"
      },
      "surface3": {
        "value": "#E4E9F0"
      },
      "line": {
        "value": "#DCE2EA"
      },
      "fg": {
        "value": "#12284C"
      },
      "muted": {
        "value": "#4F5B6E"
      },
      "subtle": {
        "value": "#5F6B7F",
        "use": "Tertiary text (≥4.5:1 on white and paper)"
      },
      "accent": {
        "value": "#FFC845"
      },
      "accentInk": {
        "value": "#12284C"
      },
      "accentText": {
        "value": "#6B4700",
        "use": "Glow-family text on white (contrast)"
      },
      "accentBorder": {
        "value": "#C99400"
      },
      "accentSoft": {
        "value": "#FFF6DC"
      },
      "occupied": {
        "value": "#12284C"
      },
      "occupiedFg": {
        "value": "#FFFFFF"
      },
      "hatch": {
        "value": [
          "#E3E7ED",
          "#CBD2DC"
        ]
      },
      "dots": {
        "value": [
          "#B8C1CE",
          "#EEF1F5"
        ]
      },
      "now": {
        "value": "#C2185B"
      }
    }
  },
  "roomState": {
    "open": {
      "fill": "accent",
      "text": "accentInk",
      "icon": "door-open",
      "label": "Open / Open until <time>"
    },
    "opensSoon": {
      "fill": "transparent",
      "border": "1px dashed accentBorder",
      "text": "accentText",
      "icon": "clock",
      "label": "Opens <time>"
    },
    "occupied": {
      "fill": "occupied",
      "text": "occupiedFg",
      "icon": "door-closed",
      "label": "Occupied / Occupied until <time>"
    },
    "unavailable": {
      "fill": "hatch",
      "text": "fg",
      "icon": "slash-circle",
      "label": "Unavailable"
    },
    "unknown": {
      "fill": "dots",
      "text": "fg",
      "icon": "question",
      "label": "Check PSU site"
    }
  },
  "map": {
    "provider": "MapLibre GL + OpenFreeMap (OpenStreetMap data, no key)",
    "dark": {
      "baseStyle": "https://tiles.openfreemap.org/styles/fiord",
      "recolor": {
        "background": "#0A1628",
        "water": "#0B2242",
        "landcover": "#0E2140 @ 0.55",
        "roads": "#1D3259",
        "labels": "#7F91AE on #0A1628 halo"
      },
      "buildings3d": "#1A2E52 @ 0.92, height = render_height"
    },
    "light": {
      "baseStyle": "https://tiles.openfreemap.org/styles/liberty",
      "remove": [
        "poi",
        "aerodrome_label"
      ]
    },
    "reservableBuildings": {
      "source": "data/footprints.json (OSM footprints)",
      "open": "#FFC845",
      "openSelected": "#FFD978",
      "quiet": {
        "dark": "#3B5A92",
        "light": "#8EA6CC"
      },
      "quietSelected": {
        "dark": "#6E93D6",
        "light": "#5E7FB8"
      }
    },
    "camera": {
      "overview": {
        "zoom": 15.35,
        "zoomPhone": 14.7,
        "pitch": 52,
        "bearing": -18
      },
      "building": {
        "zoom": 17.3,
        "pitch": 60,
        "bearing": -24
      }
    },
    "pin": {
      "height": 28,
      "radius": 999,
      "badge": 22,
      "font": "12/600",
      "openBadge": "accent on accentInk",
      "candidate": "1.5px dashed subtle"
    }
  },
  "font": {
    "family": "Overpass, sans-serif",
    "numerals": "font-variant-numeric: tabular-nums for all times and counts",
    "scale": {
      "title": {
        "size": 20,
        "weight": 600,
        "use": "Room name"
      },
      "heading": {
        "size": 18,
        "weight": 600,
        "use": "Building name"
      },
      "body": {
        "size": 14,
        "weight": 400,
        "lineHeight": 1.45
      },
      "row": {
        "size": 14,
        "weight": 600,
        "use": "List row primary"
      },
      "small": {
        "size": 12,
        "weight": 400,
        "use": "Secondary text"
      },
      "label": {
        "size": 11,
        "weight": 600,
        "letterSpacing": "0.04em",
        "transform": "uppercase",
        "use": "Section labels"
      },
      "brand": {
        "size": 15,
        "weight": 800,
        "letterSpacing": "-0.01em"
      }
    }
  },
  "space": [
    4,
    6,
    8,
    12,
    16,
    24
  ],
  "radius": {
    "control": 8,
    "panel": 12,
    "sheet": 16,
    "chip": 999
  },
  "size": {
    "sidebar": 400,
    "rowMinHeight": 44,
    "control": 40,
    "pill": 32,
    "chip": 24,
    "primaryButton": 44,
    "sheetPeek": 212,
    "sheetOpen": "70dvh"
  },
  "elevation": {
    "float": {
      "dark": "0 8px 28px rgba(0,0,0,0.35)",
      "light": "0 8px 28px rgba(18,40,76,0.16)"
    }
  },
  "motion": {
    "cameraFly": "flyTo ~1100 ms into a building, and back out to the campus",
    "sheet": "height 200 ms ease-out",
    "reducedMotion": "camera jumps, no transitions"
  },
  "accessibility": {
    "textContrast": "All text tokens meet WCAG AA 4.5:1 on every surface they're used on; checked by axe in e2e (dark and light)"
  }
}
