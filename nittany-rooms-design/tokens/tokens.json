{
  "version": "2.1.0",
  "name": "Nittany Rooms: minimal neutral dark/light, green/red states",
  "defaultTheme": "dark (Appearance: Light / Dark / Auto)",
  "implementation": "apps/web/src/index.css (CSS variables --nr-*, exposed to Tailwind as semantic colors)",
  "theme": {
    "dark": {
      "bg": {
        "value": "#0B0D10"
      },
      "surface": {
        "value": "#111418"
      },
      "surface2": {
        "value": "#1A1E24"
      },
      "surface3": {
        "value": "#242A32"
      },
      "line": {
        "value": "#262C34"
      },
      "fg": {
        "value": "#E7E9EC"
      },
      "muted": {
        "value": "#A3ACB8"
      },
      "subtle": {
        "value": "#8A94A1"
      },
      "accent (blue, actions/selection)": {
        "value": "#2563EB"
      },
      "accentInk": {
        "value": "#FFFFFF"
      },
      "accentText": {
        "value": "#7AA7FF"
      },
      "yellow (brand, opens soon, now marker)": {
        "value": "#FACC15"
      },
      "open": {
        "value": "#22C55E"
      },
      "openSoft": {
        "value": "rgba(34,197,94,0.16)"
      },
      "openText": {
        "value": "#4ADE80"
      },
      "busy": {
        "value": "#EF4444"
      },
      "busySoft": {
        "value": "rgba(239,68,68,0.16)"
      },
      "busyText": {
        "value": "#F87171"
      },
      "space (walk-in study spaces)": {
        "value": "#A78BFA"
      },
      "spaceText": {
        "value": "#C4B5FD"
      }
    },
    "light": {
      "bg": {
        "value": "#F6F7F9"
      },
      "surface": {
        "value": "#FFFFFF"
      },
      "surface2": {
        "value": "#F1F3F5"
      },
      "surface3": {
        "value": "#E5E8EC"
      },
      "line": {
        "value": "#E2E5E9"
      },
      "fg": {
        "value": "#111418"
      },
      "muted": {
        "value": "#4B5563"
      },
      "subtle": {
        "value": "#5F6874"
      },
      "accent": {
        "value": "#2563EB"
      },
      "accentInk": {
        "value": "#FFFFFF"
      },
      "accentText": {
        "value": "#1D4ED8"
      },
      "yellow": {
        "value": "#EAB308"
      },
      "open": {
        "value": "#16A34A"
      },
      "openSoft": {
        "value": "#DCFCE7"
      },
      "openText": {
        "value": "#166534"
      },
      "busy": {
        "value": "#DC2626"
      },
      "busySoft": {
        "value": "#FEE2E2"
      },
      "busyText": {
        "value": "#991B1B"
      },
      "soonText": {
        "value": "#854D0E"
      },
      "space": {
        "value": "#7C3AED"
      },
      "spaceText": {
        "value": "#5B21B6"
      }
    }
  },
  "roomState": {
    "open": {
      "fill": "openSoft",
      "text": "openText",
      "icon": "door-open",
      "label": "Open"
    },
    "opensSoon": {
      "border": "1px dashed yellow",
      "text": "soonText",
      "icon": "clock",
      "label": "Opens <time>"
    },
    "occupied": {
      "fill": "busySoft",
      "text": "busyText",
      "icon": "door-closed",
      "label": "Occupied"
    },
    "unavailable": {
      "fill": "hatch (neutral)",
      "icon": "slash-circle",
      "label": "Unavailable"
    },
    "unknown": {
      "fill": "dots (neutral)",
      "icon": "question",
      "label": "Check PSU site"
    }
  },
  "map": {
    "provider": "MapLibre GL + OpenFreeMap (OpenStreetMap data, no key)",
    "dark": {
      "baseStyle": "https://tiles.openfreemap.org/styles/fiord",
      "recolor": {
        "background": "#0B0D10",
        "water": "#0E1621",
        "landcover": "#10161D",
        "roads": "#232A33",
        "labels": "#8A94A1"
      },
      "buildings3d": "#1C2129"
    },
    "light": {
      "baseStyle": "https://tiles.openfreemap.org/styles/liberty",
      "remove": [
        "poi",
        "aerodrome_label"
      ]
    },
    "reservableBuildings": {
      "open": "#22C55E",
      "noneOpen": "#DC2626",
      "unknown": {
        "dark": "#4B5563",
        "light": "#9CA3AF"
      },
      "selectedUnknown": "#3B82F6"
    },
    "camera": {
      "overview": {
        "zoom": 15.35,
        "zoomPhone": 14.7,
        "pitch": 52,
        "bearing": -18
      },
      "building": {
        "zoom": 17.3,
        "pitch": 60,
        "bearing": -24
      }
    },
    "pin": {
      "height": 28,
      "radius": 999,
      "badge": 22,
      "font": "12/600",
      "openBadge": "accent on accentInk",
      "candidate": "1.5px dashed subtle"
    },
    "openStudySpaces": {
      "extrusion": {
        "dark": "#8B5CF6",
        "light": "#A78BFA"
      },
      "pinBadge": "space"
    }
  },
  "font": {
    "family": "Inter, system-ui, sans-serif",
    "numerals": "font-variant-numeric: tabular-nums for all times and counts",
    "scale": {
      "title": {
        "size": 20,
        "weight": 600,
        "use": "Room name"
      },
      "heading": {
        "size": 18,
        "weight": 600,
        "use": "Building name"
      },
      "body": {
        "size": 14,
        "weight": 400,
        "lineHeight": 1.45
      },
      "row": {
        "size": 14,
        "weight": 600,
        "use": "List row primary"
      },
      "small": {
        "size": 12,
        "weight": 400,
        "use": "Secondary text"
      },
      "label": {
        "size": 11,
        "weight": 600,
        "letterSpacing": "0.04em",
        "transform": "uppercase",
        "use": "Section labels"
      },
      "brand": {
        "size": 15,
        "weight": 800,
        "letterSpacing": "-0.01em"
      }
    },
    "file": "fonts/inter-latin-wght-normal.woff2 (variable, weights 100–900, SIL OFL)",
    "features": "cv11, ss03"
  },
  "space": [
    4,
    6,
    8,
    12,
    16,
    24
  ],
  "radius": {
    "control": 8,
    "panel": 12,
    "sheet": 16,
    "chip": 999
  },
  "size": {
    "sidebar": 400,
    "rowMinHeight": 44,
    "control": 40,
    "pill": 32,
    "chip": 24,
    "primaryButton": 44,
    "sheetPeek": 212,
    "sheetOpen": "70dvh"
  },
  "elevation": {
    "float": {
      "dark": "0 8px 28px rgba(0,0,0,0.35)",
      "light": "0 8px 28px rgba(18,40,76,0.16)"
    }
  },
  "motion": {
    "cameraFly": "flyTo ~1100 ms into a building, and back out to the campus",
    "sheet": "height 200 ms ease-out",
    "reducedMotion": "camera jumps, no transitions"
  },
  "accessibility": {
    "textContrast": "All text tokens meet WCAG AA 4.5:1 on every surface they're used on; checked by axe in e2e (dark and light)"
  }
}
