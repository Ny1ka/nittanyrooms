{
  "color": {
    "navy": { "value": "#12284C", "use": "Text, primary buttons, occupied rooms on light surfaces" },
    "night": { "value": "#0E1E3A", "use": "Map and floor plan canvas" },
    "nightRaised": { "value": "#1F3358", "use": "Floor buttons, occupied rooms on the night canvas" },
    "glow": { "value": "#FFC845", "use": "Open rooms, selected floor; always with navy text" },
    "glowBorder": { "value": "#C99400", "use": "Dashed outline for 'opens soon'" },
    "amberText": { "value": "#6B4700", "use": "Glow-family text on white" },
    "paper": { "value": "#F5F7FA", "use": "App background" },
    "surface": { "value": "#FFFFFF", "use": "Panels, cards, inputs" },
    "line": { "value": "#DCE2EA", "use": "Borders and dividers" },
    "inputBorder": { "value": "#B8C1CE", "use": "Input and secondary button borders" },
    "slate": { "value": "#4F5B6E", "use": "Secondary text" },
    "now": { "value": "#C2185B", "use": "Current-time marker only" },
    "unavailableHatch": { "value": "repeating-linear-gradient(135deg, #E3E7ED 0 6px, #CBD2DC 6px 8px)", "use": "Unavailable / closed" },
    "unknownDots": { "value": "radial-gradient(#B8C1CE 1px, #EEF1F5 1.5px) 0 0 / 6px 6px", "use": "Unknown or not-yet-connected availability" }
  },
  "roomState": {
    "open": { "fill": "glow", "text": "navy", "icon": "door-open", "label": "Open" },
    "opensSoon": { "fill": "surface", "border": "2px dashed glowBorder", "text": "amberText", "icon": "clock", "label": "Opens <time>" },
    "occupied": { "fill": "navy", "text": "surface", "icon": "door-closed", "label": "Occupied" },
    "unavailable": { "fill": "unavailableHatch", "text": "#3A4558", "icon": "slash-circle", "label": "Unavailable" },
    "unknown": { "fill": "unknownDots", "text": "#3A4558", "icon": "question", "label": "Check on PSU site" }
  },
  "font": {
    "family": "Overpass, sans-serif",
    "numerals": "font-variant-numeric: tabular-nums for all times",
    "scale": {
      "display": { "size": 40, "weight": 800, "letterSpacing": "-0.02em" },
      "title": { "size": 28, "weight": 800, "letterSpacing": "-0.01em" },
      "heading": { "size": 20, "weight": 600 },
      "body": { "size": 16, "weight": 400, "lineHeight": 1.5 },
      "small": { "size": 13, "weight": 400 }
    }
  },
  "space": [4, 8, 12, 16, 24, 32, 48],
  "radius": { "control": 10, "panel": 16, "sheet": 20, "chip": 999 },
  "size": { "minTouchTarget": 44, "primaryButtonHeight": 52 },
  "motion": {
    "campusToBuilding": "single zoom, about 300 ms, ease-out",
    "reducedMotion": "replace with an instant cut"
  }
}
