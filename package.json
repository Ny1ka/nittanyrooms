{
  "name": "nittany-rooms",
  "private": true,
  "description": "Student-made visual study-room finder for Penn State University Park. Not an official Penn State service.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @nittany-rooms/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "validate:data": "pnpm --filter @nittany-rooms/core validate:data",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "pnpm --filter @nittany-rooms/web build && pnpm --filter @nittany-rooms/web e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3"
  }
}
